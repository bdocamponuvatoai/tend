# Public origin used for canonical URLs, Open Graph, robots.txt, the sitemap
# and llms.txt. No trailing slash. If unset, the build falls back to
# https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
SITE_URL=https://www.example.com

# Set to "true" only after the owner approves the site going public.
# Anything else keeps every page noindex and robots.txt disallowing all crawlers.
# The build fails if this is "true" while the URL is still localhost.
SITE_INDEXABLE=false
